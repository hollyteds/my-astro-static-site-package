---
interface Props {
  class?: string;
}

const { class: addClassName, ...props } = Astro.props;
---

<div
  {...props}
  class:list={[
    "mx-auto flex aspect-[300/120] max-w-[300px] items-center justify-center rounded-box border border-base-300 bg-base-100 font-zen-maru shadow-sm",
    addClassName
  ]}
>
  <h2 class="flex aspect-[300/120] items-center justify-center text-2xl font-bold"><slot /></h2>
</div>
<style></style>
