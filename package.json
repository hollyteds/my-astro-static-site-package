{
  "name": "my-astro-static-site-package",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build --mode production",
    "build:prod": "astro check && astro build --mode production",
    "build:test": "astro check && astro build --mode test",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier --ignore-path .gitignore --write './**/*.{tsx,astro}'",
    "lint:css": "stylelint \"src/**/*.{css,astro}\"",
    "fix:css": "stylelint \"src/**/*.{css,astro}\" --fix"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.2",
    "@astrojs/react": "^5.0.4",
    "@astrojs/sitemap": "^3.7.2",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "@typescript-eslint/parser": "^8.59.0",
    "astro": "^6.1.9",
    "astro-compress": "^2.4.1",
    "astro-html-beautifier": "^1.0.5",
    "astro-icon": "^1.1.5",
    "astro-relative-links": "^0.4.2",
    "astro-simple-art-direction": "^1.1.1",
    "daisyui": "^5.5.14",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-tailwindcss": "^3.18.3",
    "postcss-html": "^1.8.1",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.7.3",
    "react-dom": "^19.2.5",
    "sass-embedded": "^1.99.0",
    "stylelint": "^17.9.0",
    "stylelint-config-property-sort-order-smacss": "^11.2.0",
    "stylelint-order": "^8.1.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18"
  }
}
