{
  "name": "my-astro-static-site-package",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build --mode production",
    "build:prod": "astro check && astro build --mode production",
    "build:test": "astro check && astro build --mode test",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier --ignore-path .gitignore --write './**/*.{tsx,astro}'",
    "lint:css": "stylelint \"src/**/*.{css,astro}\"",
    "fix:css": "stylelint \"src/**/*.{css,astro}\" --fix"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.3",
    "@playwright/test": "^1.62.1",
    "@types/node": "^25.9.5",
    "@typescript-eslint/parser": "^8.67.0",
    "astro": "^7.2.0",
    "astro-html-beautifier": "^1.0.5",
    "daisyui": "^5.7.16",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-tailwindcss": "^4.2.0",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sass-embedded": "^1.100.0",
    "stylelint": "^17.14.1",
    "stylelint-config-property-sort-order-smacss": "^11.2.0",
    "stylelint-order": "^8.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3"
  }
}
